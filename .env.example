# Site login (optional — leave blank to disable the login gate)
VITE_AUTH_USERNAME=your_username_here
VITE_AUTH_PASSWORD=your_password_here

# Marketing account login (restricted to Marketing + LTGP:CAC pages only)
VITE_AUTH_MARKETING_USERNAME=your_marketing_username_here
VITE_AUTH_MARKETING_PASSWORD=your_marketing_password_here

# Airtable credentials
# Get your Personal Access Token from: https://airtable.com/create/tokens
# Your Base ID is in the URL: https://airtable.com/appXXXXXXXXXXXXXX/...
VITE_AIRTABLE_API_KEY=your_personal_access_token_here
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table names in your Airtable base (update these to match your actual table names)
# VITE_AIRTABLE_SALES_TABLE=Sales
# VITE_AIRTABLE_RECRUITER_TABLE=Recruiters

# Marketing — Airtable bases (two separate bases)
VITE_AIRTABLE_CLIENTS_BASE_ID=appVEGUse449LuZpZ
VITE_AIRTABLE_CANDIDATES_BASE_ID=appa05OOLs3y4DF14

# Marketing — Meta Ads API
VITE_META_TOKEN=your_meta_ads_token_here

# Recruitment — Open Jobs (n8n webhook, proxies JobAdder)
VITE_N8N_OPEN_JOBS_WEBHOOK_URL=https://n8n.srv1303295.hstgr.cloud/webhook/getOpenJobs

# Recruitment — Leads Contacted by Bot (n8n Voice Call Dashboard API, via api/voice-stats.ts)
# SERVER-ONLY: no VITE_ prefix. Set in Vercel env + local .env; value of the n8n Header Auth
# credential (sent as the x-dashboard-token header). Never expose to the browser.
N8N_DASH_TOKEN=your_voice_stats_token_here

# Recruitment — Pipeline Stage KPIs (n8n webhook, proxies JobAdder: reference checks,
# candidates pitched to client, internal interviews bot vs manually booked)
VITE_N8N_JOBADDER_STAGES_WEBHOOK_URL=https://n8n.srv1303295.hstgr.cloud/webhook/recruiter-kpi-jobadder-stages

# Retention — JobAdder placements (start date from 1 Jun 2026) with their notes (n8n webhook)
VITE_N8N_RETENTION_WEBHOOK_URL=https://n8n.srv1303295.hstgr.cloud/webhook/retention-placements

# Marketing — Organic (api/organic.ts, api/cron/follower-snapshot.ts). SERVER-ONLY, no VITE_ prefix.
# Page access token with pages_read_engagement + read_insights + instagram_basic + instagram_manage_insights.
META_PAGE_TOKEN=your_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
# Optional: discovered from the Page's linked Instagram business account when blank
META_IG_USER_ID=
# Les's personal Instagram (professional account linked to the Page); leave blank until connected
META_LES_IG_USER_ID=

# Marketing — settings + follower snapshots (Supabase, SERVER-ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Password required to save Marketing settings (falls back to VITE_AUTH_PASSWORD)
AUTH_ADMIN_PASSWORD=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes
CRON_SECRET=your_random_secret_here
